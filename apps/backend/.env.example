# Copy this file to .env and fill in the values.
# NEVER commit the .env file to the repository.
# Real QA and production values go in GitHub (Settings > Environments) or in the hosting provider.

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- PostgreSQL + pgvector ----------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mentor
SPRING_DATASOURCE_USERNAME=mentor
SPRING_DATASOURCE_PASSWORD=

# ---------- MongoDB ----------
SPRING_DATA_MONGODB_URI=mongodb://mentor:CHANGE_ME@localhost:27017/mentor?authSource=admin

# ---------- Redis ----------
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ---------- Keycloak (OAuth 2.0 resource server) ----------
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8081/realms/mentor
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://localhost:8081/realms/mentor/protocol/openid-connect/certs

# ---------- Payments (sandbox only) ----------
PAYMENT_PROVIDER=kushki
KUSHKI_PUBLIC_KEY=
KUSHKI_PRIVATE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Video calls ----------
VIDEO_PROVIDER=webrtc
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Optional second option
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# ---------- Email ----------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- AI and automation ----------
LLM_API_URL=
LLM_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook
