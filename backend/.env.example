# Copy this file to .env and fill in the values.
# Direct local runs: activate the local Spring profile to import this file.
# Use KEY=value Java properties syntax; do not add export or shell quoting.
# NEVER commit the .env file to the repository.
# Real QA and production values go in GitHub (Settings > Environments) or in the hosting provider.

# ---------- PostgreSQL + pgvector ----------
# Host/port for direct JVM runs; Compose uses the postgres service internally.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=mentor
POSTGRES_PASSWORD=
POSTGRES_DB=mentor

# ---------- MongoDB (Spring Boot 4) ----------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_AUTH_DATABASE=admin
MONGO_USER=mentor
MONGO_PASSWORD=
MONGO_DB=mentor

# ---------- Redis (ephemeral cache) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Keycloak ----------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_REALM=mentor
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/mentor

# ---------- Backend (Spring Boot) ----------
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional full JDBC override for direct runs or hosted PostgreSQL; use matching credentials.
# Leave these commented to use POSTGRES_HOST/PORT/DB/USER/PASSWORD above.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mentor
# SPRING_DATASOURCE_USERNAME=mentor
# SPRING_DATASOURCE_PASSWORD=
# Optional hosted MongoDB override: use this lowercase property in .env,
# or SPRING_MONGODB_URI as a real process environment variable (Boot 4).
# MONGO_DB still selects the application database. URI credentials must be percent-encoded.
# spring.mongodb.uri=mongodb://USER:ENCODED_PASSWORD@HOST:27017/mentor?authSource=admin


# ---------- Web app and landing page (built from ../frontend/web and ../frontend/landing) ----------
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_CLIENT_ID=mentor-web
PUBLIC_APP_URL=http://localhost:5173

# ---------- Payments (sandbox only) ----------
PAYMENT_PROVIDER=kushki
KUSHKI_PUBLIC_KEY=
KUSHKI_PRIVATE_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Video calls ----------
VIDEO_PROVIDER=webrtc
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
# Optional second option
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# ---------- Email ----------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- AI and automation ----------
LLM_API_URL=
LLM_API_KEY=
N8N_WEBHOOK_URL=http://localhost:5678/webhook
