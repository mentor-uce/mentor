---
import Container from '../atoms/Container.astro';
import Icon from '../atoms/Icon.astro';

const navLinks = [
  { href: '#top', label: 'Home' },
  { href: '#how-it-works', label: 'How It Works' },
  { href: '#benefits', label: 'Benefits' },
  { href: '#trust', label: 'Trust & Security' },
  { href: '#faq', label: 'FAQ' },
];

const legalLinks = [
  { href: '#terms', label: 'Terms & Conditions (Academic Placeholder)' },
  { href: '#privacy', label: 'Privacy Policy (Academic Placeholder)' },
];
---

<footer class="bg-mentor-night text-slate-400 py-12 md:py-16 border-t border-slate-800">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 pb-12 border-b border-slate-800">
      <!-- Col 1: Brand & UCE Identification -->
      <div class="md:col-span-5 space-y-4">
        <div class="flex items-center gap-2.5">
          <div
            class="w-8 h-8 rounded-lg bg-gradient-ribbon flex items-center justify-center text-white"
          >
            <Icon name="academic-cap" class="w-4 h-4" />
          </div>
          <span class="font-heading font-bold text-xl text-white tracking-tight">
            Mentor
          </span>
        </div>

        <p class="text-sm text-slate-300 leading-relaxed max-w-sm">
          Academic peer-to-peer tutoring network designed for Universidad Central del Ecuador. Teaching is also learning.
        </p>

        <div class="pt-2">
          <span
            class="inline-block px-3 py-1 rounded-md text-xs font-medium bg-slate-800 text-mentor-sky border border-slate-700"
          >
            Universidad Central del Ecuador • Software Architecture 2026
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-sm font-semibold font-heading text-white uppercase tracking-wider">
          Navigation
        </h4>
        <ul class="space-y-2 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-mentor-sky transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mentor-sky rounded"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Academic Project Notice -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-sm font-semibold font-heading text-white uppercase tracking-wider">
          Academic Framework
        </h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Developed as part of the Software Architecture curriculum. This landing page is statically generated with Astro and styled with Tailwind CSS according to the Mentor Design System.
        </p>
        <p class="text-xs text-slate-500">
          All university brand trademarks belong to Universidad Central del Ecuador.
        </p>
      </div>
    </div>

    <!-- Bottom Legal & Copyright -->
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500"
    >
      <p>© 2026 Mentor Project. All rights reserved.</p>

      <ul class="flex flex-wrap gap-4 sm:gap-6">
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-slate-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mentor-sky rounded"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
