---
/**
 * Footer Organism
 *
 * Implements the global footer strictly adhering to:
 * - Background color: Noche (#0B1220)
 * - Text color: Slate-300 / Slate-400 with Cielo (#38BDF8) hover states
 * - Brand Manual Isotype + Wordmark + Tagline
 * - Clear identification of Universidad Central del Ecuador & academic project context
 */
import Container from '../atoms/Container.astro';
import MentorLogo from '../atoms/MentorLogo.astro';

const navLinks = [
  { href: '#top', label: 'Inicio' },
  { href: '#problem', label: 'El Reto' },
  { href: '#how-it-works', label: 'Cómo Funciona' },
  { href: '#benefits', label: 'Beneficios' },
  { href: '#trust', label: 'Confianza y Seguridad' },
  { href: '#faq', label: 'Preguntas Frecuentes' },
];

const legalLinks = [
  { href: '#terms', label: 'Términos y Condiciones (Entorno Académico)' },
  { href: '#privacy', label: 'Política de Privacidad (Entorno Académico)' },
];
---

<footer class="bg-mentor-night text-slate-400 py-12 md:py-16 border-t border-slate-800">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 pb-12 border-b border-slate-800">
      <!-- Col 1: Brand & Institutional Identity -->
      <div class="md:col-span-5 space-y-4">
        <MentorLogo variant="horizontal" theme="color-on-dark" isotypeSize={34} />

        <p class="text-sm text-slate-300 leading-relaxed max-w-sm pt-2">
          Plataforma de tutorías académicas entre pares diseñada para la Universidad Central del Ecuador. Enseñar también es aprender.
        </p>

        <div class="pt-2">
          <span
            class="inline-block px-3 py-1 rounded-md text-xs font-medium bg-slate-800 text-mentor-sky border border-slate-700"
          >
            Universidad Central del Ecuador • Arquitectura de Software 2026
          </span>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-sm font-semibold font-heading text-white uppercase tracking-wider">
          Navegación
        </h4>
        <ul class="space-y-2 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="hover:text-mentor-sky transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mentor-sky rounded py-0.5 inline-block"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Col 3: Academic Framework Notice -->
      <div class="md:col-span-4 space-y-3">
        <h4 class="text-sm font-semibold font-heading text-white uppercase tracking-wider">
          Marco del Proyecto
        </h4>
        <p class="text-xs text-slate-400 leading-relaxed">
          Desarrollado como proyecto para las asignaturas de Arquitectura de Software y Programación en Inglés. Implementado con Astro en modo estático (SSG), Tailwind CSS y el Sistema de Diseño oficial de Mentor.
        </p>
        <p class="text-xs text-slate-500">
          Todas las marcas y signos distintivos universitarios pertenecen a la Universidad Central del Ecuador.
        </p>
      </div>
    </div>

    <!-- Bottom Legal & Copyright Notice -->
    <div
      class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500"
    >
      <p>© 2026 Proyecto Mentor - UCE. Todos los derechos reservados.</p>

      <ul class="flex flex-wrap gap-4 sm:gap-6">
        {
          legalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-slate-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-mentor-sky rounded"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</footer>
