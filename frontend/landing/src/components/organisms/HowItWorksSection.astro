---
import Container from '../atoms/Container.astro';
import StudentFlow from '../sections/StudentFlow.astro';
import TutorFlow from '../sections/TutorFlow.astro';
---

<section id="how-it-works" class="py-16 md:py-24 bg-slate-50/50 border-t border-slate-100">
  <Container>
    <div class="max-w-3xl mx-auto text-center mb-14">
      <span
        class="inline-block px-3 py-1 mb-3 text-xs font-semibold uppercase tracking-wider text-mentor-deep-turquoise bg-mentor-ice rounded-full"
      >
        Step-by-Step Experience
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold font-heading text-mentor-night mb-4">
        How Mentor Works
      </h2>
      <p class="text-base text-slate-600 leading-relaxed">
        Whether you are seeking guidance to master a challenging course or ready to share your knowledge with fellow students, Mentor provides a clear, structured path.
      </p>
    </div>

    <div class="space-y-10">
      <!-- Student Flow Organism -->
      <StudentFlow />

      <!-- Tutor Flow Organism -->
      <TutorFlow />
    </div>
  </Container>
</section>
