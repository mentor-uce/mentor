---
import Button from '../atoms/Button.astro';
import Container from '../atoms/Container.astro';
import Icon from '../atoms/Icon.astro';
---

<section id="top" class="relative overflow-hidden pt-12 pb-20 md:pt-20 md:pb-28 bg-gradient-to-b from-mentor-ice/40 via-white to-white">
  <!-- Subtle decorative ambient glows -->
  <div
    class="absolute top-0 right-1/4 -z-10 w-96 h-96 bg-mentor-sky/10 rounded-full blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute top-1/3 left-10 -z-10 w-80 h-80 bg-mentor-turquoise/10 rounded-full blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Column: Copy & Actions -->
      <div class="lg:col-span-7 text-center lg:text-left">
        <!-- Brand Tagline Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-mentor-sky/30 shadow-sm mb-6">
          <span class="w-2 h-2 rounded-full bg-mentor-sky animate-pulse"></span>
          <span class="text-xs font-semibold text-mentor-night uppercase tracking-wider">
            Teaching Is Also Learning
          </span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-heading text-mentor-night tracking-tight leading-[1.1] mb-6">
          Learn and Teach <br class="hidden sm:inline" />
          <span class="bg-gradient-ribbon bg-clip-text text-transparent">
            Together
          </span>
        </h1>

        <!-- Subtitle & Value Proposition -->
        <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed mb-8">
          The official peer-tutoring network for Universidad Central del Ecuador. Overcome challenging courses with guidance from top students, or share your knowledge as a peer tutor.
        </p>

        <!-- CTA Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-10">
          <Button href="#register" variant="primary" size="lg" class="w-full sm:w-auto shadow-md">
            <span>Get Started with @uce.edu.ec</span>
            <Icon name="arrow-right" class="w-4 h-4 ml-1" />
          </Button>
          <Button href="#how-it-works" variant="outline" size="lg" class="w-full sm:w-auto">
            <span>Explore How It Works</span>
          </Button>
        </div>

        <!-- Trust Highlights -->
        <div class="pt-6 border-t border-slate-200/80 grid grid-cols-3 gap-4 max-w-md mx-auto lg:mx-0 text-left">
          <div>
            <p class="font-heading font-bold text-lg text-mentor-night">100%</p>
            <p class="text-xs text-slate-500">UCE Verified</p>
          </div>
          <div>
            <p class="font-heading font-bold text-lg text-mentor-night">Peer-to-Peer</p>
            <p class="text-xs text-slate-500">Student Mentors</p>
          </div>
          <div>
            <p class="font-heading font-bold text-lg text-mentor-night">Zero Risk</p>
            <p class="text-xs text-slate-500">Safe Test Flow</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Academic Collaboration Visual Card -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none bg-white p-6 sm:p-8 rounded-2xl border border-slate-200 shadow-xl">
          <!-- Top Accent Ribbon -->
          <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-ribbon rounded-t-2xl"></div>

          <!-- Card Header -->
          <div class="flex items-center justify-between pb-5 border-b border-slate-100">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-mentor-ice flex items-center justify-center text-mentor-deep-turquoise font-bold">
                <Icon name="book-open" class="w-5 h-5" />
              </div>
              <div>
                <p class="text-xs font-semibold uppercase text-mentor-deep-turquoise tracking-wider">Active Session</p>
                <h4 class="font-heading font-bold text-sm text-mentor-night">Calculus & Linear Algebra</h4>
              </div>
            </div>
            <span class="inline-flex items-center gap-1 text-[11px] font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Confirmed
            </span>
          </div>

          <!-- Interactive Snippet: Tutor & Student Interaction -->
          <div class="py-5 space-y-4">
            <div class="flex items-start gap-3 p-3 rounded-lg bg-slate-50 border border-slate-100">
              <div class="w-8 h-8 rounded-full bg-mentor-indigo/15 text-mentor-indigo flex items-center justify-center font-bold text-xs shrink-0">
                T
              </div>
              <div class="text-xs space-y-1">
                <p class="font-semibold text-mentor-night">Peer Tutor (Semester 8)</p>
                <p class="text-slate-600">"We will solve last semester's exam problems and clarify differential equations."</p>
              </div>
            </div>

            <div class="flex items-start gap-3 p-3 rounded-lg bg-mentor-ice/40 border border-mentor-sky/20">
              <div class="w-8 h-8 rounded-full bg-mentor-sky/20 text-mentor-night flex items-center justify-center font-bold text-xs shrink-0">
                S
              </div>
              <div class="text-xs space-y-1">
                <p class="font-semibold text-mentor-night">Student (Semester 2)</p>
                <p class="text-slate-600">"Session confirmed! Looking forward to reviewing the theorem demonstrations."</p>
              </div>
            </div>
          </div>

          <!-- Bottom Metric & Verification Pill -->
          <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500">
            <div class="flex items-center gap-1.5 text-mentor-deep-turquoise font-medium">
              <Icon name="shield-check" class="w-4 h-4" />
              <span>Verified @uce.edu.ec Student</span>
            </div>
            <div class="flex items-center gap-1 text-amber-500 font-semibold">
              <Icon name="star" class="w-3.5 h-3.5" />
              <span>5.0 Rating</span>
            </div>
          </div>
        </div>

        <!-- Floating Badge: Dual Role Support -->
        <div class="hidden sm:flex absolute -bottom-5 -left-4 items-center gap-2.5 bg-mentor-night text-white px-4 py-2.5 rounded-xl shadow-lg border border-slate-700">
          <div class="w-2.5 h-2.5 rounded-full bg-mentor-turquoise"></div>
          <p class="text-xs font-medium">
            Learn as student • Teach as tutor
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
