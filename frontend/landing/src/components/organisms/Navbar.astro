---
/**
 * Navbar Organism
 *
 * Top navigation bar strictly implementing the Mentor Brand Manual:
 * - Brand Isotype + Wordmark + Tagline using MentorLogo component
 * - Safe margin zones (2x 'M' stroke width)
 * - Navigation links styled with Inter typography
 * - High-contrast calls-to-action (Sign In ghost, Register primary with Cinta gradient)
 * - Mobile responsive drawer with accessible ARIA toggle
 */
import Button from '../atoms/Button.astro';
import Container from '../atoms/Container.astro';
import Icon from '../atoms/Icon.astro';
import MentorLogo from '../atoms/MentorLogo.astro';
import NavigationLink from '../molecules/NavigationLink.astro';

// Navigation links aligned with the landing page section IDs
const navLinks = [
  { href: '#top', label: 'Inicio' },
  { href: '#problem', label: 'El Reto' },
  { href: '#how-it-works', label: 'Cómo Funciona' },
  { href: '#benefits', label: 'Beneficios' },
  { href: '#trust', label: 'Confianza y Seguridad' },
  { href: '#faq', label: 'Preguntas Frecuentes' },
];
---

<header
  class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200"
>
  <Container>
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Brand Logo Link (with 2x safety clearance) -->
      <a
        href="#top"
        class="flex items-center group rounded-lg focus-visible:ring-2 focus-visible:ring-mentor-sky p-1.5 transition-transform hover:scale-[1.01]"
        aria-label="Mentor - Enseñar también es aprender"
      >
        <MentorLogo variant="horizontal" theme="color-on-light" isotypeSize={38} />
      </a>

      <!-- Desktop Navigation Links (Inter regular / medium) -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2" aria-label="Main Navigation">
        {navLinks.map((link) => (
          <NavigationLink href={link.href} label={link.label} />
        ))}
      </nav>

      <!-- Desktop Action Buttons -->
      <div class="hidden sm:flex items-center gap-3">
        <Button href="#login" variant="ghost" size="sm" ariaLabel="Iniciar sesión en Mentor">
          Iniciar sesión
        </Button>
        <Button href="#register" variant="primary" size="sm" ariaLabel="Registrarse en Mentor">
          Registrarme
        </Button>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          class="p-2 rounded-lg text-slate-700 hover:text-mentor-night hover:bg-mentor-ice/60 focus:outline-none focus-visible:ring-2 focus-visible:ring-mentor-sky"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Alternar menú de navegación"
        >
          <span id="menu-icon-open">
            <Icon name="menu" class="w-6 h-6" />
          </span>
          <span id="menu-icon-close" class="hidden">
            <Icon name="close" class="w-6 h-6" />
          </span>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Navigation -->
    <div
      id="mobile-nav"
      class="hidden lg:hidden border-t border-slate-100 py-4 space-y-3 bg-white"
      aria-label="Navegación Móvil"
    >
      <nav class="flex flex-col space-y-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 text-base font-medium text-slate-700 hover:text-mentor-indigo hover:bg-mentor-ice/60 rounded-md transition-colors mobile-nav-link"
          >
            {link.label}
          </a>
        ))}
      </nav>
      <div class="pt-4 border-t border-slate-100 flex flex-col gap-2 sm:hidden">
        <Button href="#login" variant="outline" size="md" class="w-full">
          Iniciar sesión
        </Button>
        <Button href="#register" variant="primary" size="md" class="w-full">
          Registrarme
        </Button>
      </div>
    </div>
  </Container>
</header>

<script>
  /**
   * Accessible Mobile Navigation Drawer Script
   * Handles ARIA expanded states and closing drawer on anchor clicks.
   */
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileNav = document.getElementById('mobile-nav');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  if (menuButton && mobileNav && openIcon && closeIcon) {
    const toggleMenu = () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', String(!isExpanded));
      mobileNav.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    };

    menuButton.addEventListener('click', toggleMenu);

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (!mobileNav.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  }
</script>
