---
import Icon from '../atoms/Icon.astro';

interface Props {
  question: string;
  answer: string;
  open?: boolean;
  class?: string;
}

const { question, answer, open = false, class: className = '' } = Astro.props;
---

<details
  class={`group bg-white rounded-xl border border-slate-200 overflow-hidden transition-all duration-200 hover:border-slate-300 ${className}`}
  open={open}
>
  <summary
    class="flex items-center justify-between p-5 text-left font-medium text-mentor-night cursor-pointer list-none select-none focus-visible:outline-none focus-visible:bg-slate-50"
  >
    <span class="font-heading font-semibold text-base pr-4">
      {question}
    </span>
    <span
      class="text-slate-400 group-open:rotate-180 transition-transform duration-200 shrink-0"
    >
      <Icon name="chevron-down" class="w-5 h-5" />
    </span>
  </summary>
  <div class="px-5 pb-5 pt-1 text-sm text-slate-600 leading-relaxed border-t border-slate-100">
    <p>{answer}</p>
  </div>
</details>
