---
/**
 * PublicLayout Layout
 *
 * Base public layout for the Mentor Landing Page.
 * - Imports Poppins (700, 500, 400) and Inter (700, 500, 400) typography as specified in Brand Manual (p. 07)
 * - Sets brand metadata, accessible skip link, and semantic structure
 * - Background default: White with text in Noche (#0B1220)
 */
import Navbar from '../components/organisms/Navbar.astro';
import Footer from '../components/organisms/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Mentor — Enseñar también es aprender | Tutorías entre pares UCE',
  description = 'Plataforma oficial de tutorías académicas entre pares de la Universidad Central del Ecuador. Conéctate con compañeros verificados y potencia tu aprendizaje.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_EC" />

    <!-- Official Typography: Inter (Text & UI) and Poppins (Headings & Logo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-mentor-night font-sans antialiased selection:bg-mentor-sky/20 selection:text-mentor-night">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-mentor-night focus:text-white focus:rounded-md focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-mentor-sky"
    >
      Saltar al contenido principal
    </a>

    <!-- Top Navigation Organism -->
    <Navbar />

    <!-- Main Content Container -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Global Footer Organism -->
    <Footer />
  </body>
</html>
